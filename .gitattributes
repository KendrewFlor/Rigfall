* text=auto eol=lf

# Binary assets
*.png binary
*.wav binary
*.ttf binary

# Unity YAML assets merge better as text with LF endings
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf

# Generated files (rebuilt by the scripts in tools/ and blender/; CI checks they're current)
Assets/Rigfall/Resources/Models/*.json linguist-generated=true
Assets/Rigfall/Resources/Data/maps.json linguist-generated=true
